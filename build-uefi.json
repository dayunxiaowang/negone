{
	"instructions":
	{
		"cargo":
		{
			"cmd":["cargo","build","--target","x86_64-unknown-uefi","--package","loadefi","--package","negone-core","--package","cvsched"],
			"progressive":true
		},
		"memcpy":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/memcpy.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/memcpy.asm"]
		},
		"memset":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/memset.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/memset.asm"]
		},
		"memcmp":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/memcmp.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/memcmp.asm"]
		},
		"strlen":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/strlen.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/strlen.asm"]
		},
		"config":
		{
			"cmd":["{python}","./build/makeueficonfig.py","./build/DefaultUefiConfig.json","./bin/{outdir}/NegOneConfig.bin"]
		},
		"NegOne":
		{
			"cmd":["lld-link","./target/x86_64-unknown-uefi/{cargo_preset}/libnegone_core.a","{objpath}/memcpy.obj","{objpath}/memset.obj","{objpath}/memcmp.obj","{objpath}/strlen.obj","/OUT:./bin/{outdir}/NegOne.efi","/SUBSYSTEM:EFI_RUNTIME_DRIVER","/ENTRY:NegOneDriverEntry","/PDB:./bin/{outdir}/NegOne.pdb"],
			"dependencies":["cargo","memcpy","memset","memcmp","strlen"]
		},
		"cvsched":
		{
			"cmd":["lld-link","./target/x86_64-unknown-uefi/{cargo_preset}/libcvsched.a","/OUT:./bin/{outdir}/cvsched.efi","/SUBSYSTEM:EFI_BOOT_SERVICE_DRIVER","/ENTRY:NegOneDriverEntry","/PDB:./bin/{outdir}/cvsched.pdb"],
			"dependencies":["cargo"]
		},
		"image":
		{
			"cmd":
			[
				"{python}","mkimg.py",
				"-md","::/EFI",
				"-md","::/EFI/BOOT",
				"-c","./target/x86_64-unknown-uefi/{cargo_preset}/loadefi.efi|::/EFI/BOOT/bootx64.efi",
				"-c","bin/{outdir}/cvsched.efi|::/",
				"-c","bin/{outdir}/NegOne.efi|::/",
				"-c","bin/{outdir}/NegOneConfig.bin|::/",
				"-o","./bin/{outdir}/NegOne-Uefi.img"
			],
			"dependencies":["NegOne","cvsched","config"]
		},
		"vhdx":
		{
			"cmd":["qemu-img","convert","-f","raw","-O","vhdx","./bin/{outdir}/NegOne-Uefi.img","./bin/{outdir}/NegOne-Uefi.vhdx"],
			"dependencies":["image"]
		},
		"vmdk":
		{
			"cmd":["qemu-img","convert","-f","raw","-O","vmdk","./bin/{outdir}/NegOne-Uefi.img","./bin/{outdir}/NegOne-Uefi.vmdk"],
			"dependencies":["image"]
		}
	},
	"common_flags":
	{
		"nasm":["-fwin64","-D_VCRUNTIME_BUILD_QSPECTRE","-g","-o","{objpath}/{instruction}.obj","-l","{objpath}/{instruction}.lst","-Ox"],
		"lld-link":["/NODEFAULTLIB","/NOLOGO","/DEBUG","/OPT:REF","/TSAWARE:NO","/Machine:X64","/ERRORREPORT:QUEUE"]
	},
	"opt_flags":
	{
		"lld-link":["/OPT:ICF"],
		"cargo":["--release"]
	},
	"extra_env":
	{
		"AR_x86_64-unknown-uefi":"llvm-ar",
		"CC_x86_64-unknown-uefi":"clang-cl",
		"CFLAGS_x86_64-unknown-uefi":"/GS- --target=x86_64-pc-windows-msvc -mno-sse -gcodeview"
	},
	"internal_var":
	{
		"outdir_dev":"compchk_uefix64",
		"outdir_rel":"compfre_uefix64"
	}
}