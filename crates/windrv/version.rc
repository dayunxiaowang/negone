// The verrsrc.h and ntdef.h files can't be installed in Linux in regular means.
// So, copy what we may need from them into a local header file.
#include "version.h"

//
// Version Information resources
//
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 VERSIONINFO
	FILEVERSION     0,1,0,0
	PRODUCTVERSION  0,1,0,0
	FILEOS          VOS_NT_WINDOWS32
	FILETYPE        VFT_DRV
	FILESUBTYPE     VFT2_DRV_SYSTEM
	FILEFLAGSMASK   0
	FILEFLAGS       0
{
	BLOCK "StringFileInfo"
	{
		BLOCK "040901B5"
		{
			VALUE "Comments", "NegOne CVM Scheduler Driver for Windows"
			VALUE "CompanyName", "NegOne contributors"
			VALUE "FileDescription", "NegOne CVM Scheduler Driver for Windows"
			VALUE "FileVersion", "0.1.0"
			VALUE "InternalName", "NegOne"
			VALUE "LegalCopyright", "Copyright 2018-2026 Zero Tang; NegOne modifications by respective contributors."
			VALUE "LegalTrademarks", ""
			VALUE "OriginalFilename", "NegOne.sys"
			VALUE "PrivateBuild", ""
			VALUE "ProductName", "NegOne Hypervisor for Windows"
			VALUE "ProductVersion", "0.1.0"
			VALUE "SpecialBuild", ""
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 0x01B5
	}
}
